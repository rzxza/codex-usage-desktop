{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Usage Desktop",
  "version": "2.2.1",
  "identifier": "com.ccusage.codex.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Usage Desktop",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "devtools": true
      },
      {
        "label": "compact",
        "title": "Codex Monitor",
        "url": "index.html#/compact",
        "width": 390,
        "height": 300,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2OTJCNURENUYyRTNBODUKUldTRk9pNWYzYldTOW1CRTZLWHdYT1pCOFBWR0kzYU13Mnc4ckxXNmhub1lOOGhwR0lrWWVGWDUK",
      "endpoints": [
        "https://github.com/rzxza/codex-usage-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
